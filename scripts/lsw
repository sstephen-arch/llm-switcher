#!/bin/zsh
# lsw: LLM Switcher from the terminal. Talks to the app's gateway on this Mac (127.0.0.1:11436),
# which knows every engine (oMLX, Splash, Ollama, LM Studio, llama.cpp), their ports and the
# Claude slot picks, and starts an engine when it's needed.
#
#   lsw status                  engines, which one Claude uses, slot picks
#   lsw models                  every model, by engine
#   lsw use <engine>            show/use that engine (live at once unless Claude Desktop is local)
#   lsw start|stop <engine>     start or stop an engine
#   lsw claude [--open] [slot] [args]
#                               Claude Code on a local model (slot: sonnet, opus, fable, haiku,
#                               sonnet46; default sonnet). Lean setup, sandboxed, with guard rails
#                               (--open: no command deny list, unsandboxed commands may be approved).
#   lsw stats [model|slot] [--since 2h]
#                               speed, cache reuse and failures from the request log, per model
#   lsw buildbench <model|slot> [minutes]
#                               agent benchmark: the model builds a small Swift library in a
#                               sandbox, with real test results fed back each pass
#   lsw codex [model] [args]    Codex on a local model (default: the Sonnet slot's model)
#   lsw tune <model|slot>       the model's published recommended settings (apply in the app)
#   lsw bench <model|slot> [hard|all|none] [default|off|low|medium|high]
#                               speed, tool call and coding benchmark (results also in the app)
#
# Installed by LLM Switcher's release script; claude-omlx is now a shortcut to `lsw claude`.

GATEWAY="http://127.0.0.1:11436"
APP_RES="${LSW_APP_RES:-/Applications/LLM Switcher.app/Contents/Resources}"

gw_up() { curl -s -m 2 -o /dev/null "$GATEWAY/health"; }
need_gateway() {
  gw_up && return
  open -g -a "LLM Switcher"
  for i in {1..20}; do sleep 1; gw_up && return; done
  echo "❌ LLM Switcher isn't running. Open it from Applications." >&2; exit 1
}
# POST a control call; prints the JSON reply, fails on an HTTP error.
ctl() {
  local out code
  out=$(curl -s -m "${3:-30}" -w '\n%{http_code}' -X POST "$GATEWAY/local/$1" -H 'content-type: application/json' -d "$2")
  code=${out##*$'\n'}; out=${out%$'\n'*}
  print -r -- "$out"
  [[ $code == 200 ]]
}
# {"key": "value"} with the value safely escaped (model names may hold any character).
jarg() { /usr/bin/python3 -c 'import json,sys; print(json.dumps({sys.argv[1]: sys.argv[2]}))' "$1" "$2"; }
# Reads a field from JSON on stdin: jget engine / jget 'slots.claude-sonnet-5'
jget() { /usr/bin/python3 -c 'import sys,json
v=json.load(sys.stdin)
for k in sys.argv[1].split("."): v=(v or {}).get(k) if isinstance(v,dict) else None
print("" if v is None else v)' "$1"; }

slot_id() {
  case "$1" in
    opus) echo claude-opus-5 ;; fable) echo claude-fable-5 ;; haiku) echo claude-haiku-4-5-20251001 ;;
    sonnet46) echo claude-sonnet-4-6 ;; sonnet|"") echo claude-sonnet-5 ;; *) return 1 ;;
  esac
}

# Makes sure the engine behind a slot or model is running (a first start can take a while).
ensure() {
  local reply
  echo "… making sure $1 is ready" >&2
  reply=$(ctl ensure "$(jarg model "$1")" 7200) || { echo "❌ $(print -r -- "$reply" | jget error)" >&2; exit 1; }
}

cmd=$1; [[ $# -gt 0 ]] && shift
case "$cmd" in
  status|"")
    need_gateway
    curl -s -m 30 "$GATEWAY/local/status" | /usr/bin/python3 -c 'import sys,json
s=json.load(sys.stdin)
print("Claude Desktop: {claude} · engine for Claude: {engine} · menu shows: {shown}".format(**s))
for e in s["engines"]:
    if not e["available"]: continue
    dot = "●" if e["running"] else "○"
    print("  {} {:<10} port {:<6} {} models".format(dot, e["label"], e["port"], len(e["models"])))
print("Slots:")
for k, v in sorted(s["slots"].items()): print("  {:<28} {}".format(k, v))
print("Gateway 127.0.0.1:{}".format(s["gateway"]) + (" · sharing on :{}".format(s["sharing"]) if s["sharing"] else ""))'
    ;;
  models)
    need_gateway
    curl -s -m 30 "$GATEWAY/local/status" | /usr/bin/python3 -c 'import sys,json
for e in json.load(sys.stdin)["engines"]:
    names = e.get("installed") or e["models"]
    if names:
        print(e["label"] + ("" if e["running"] else "  (stopped: starts when a model is used)"))
        [print("  " + m) for m in names]'
    ;;
  use|start|stop)
    [[ -n $1 ]] || { echo "usage: lsw $cmd <omlx|splash|ollama|lmstudio|llamacpp>" >&2; exit 2; }
    need_gateway
    reply=$(ctl "$cmd" "$(jarg engine "$1")" 600) || { echo "❌ $(print -r -- "$reply" | jget error)" >&2; exit 1; }
    note=$(print -r -- "$reply" | jget note); [[ -n $note ]] && echo "$note"
    echo "✓ $cmd $1"
    ;;
  claude)
    OPEN=0; [[ $1 == --open ]] && { OPEN=1; shift; }
    if [[ -n $1 ]] && SLOT=$(slot_id "$1"); then shift; else SLOT=claude-sonnet-5; fi
    need_gateway
    ensure "$SLOT"
    # Rules: yours (~/.claude/local-model-rules.md) or the app's default, plus the guard rails
    # (always, unless --open), plus the project's AGENTS.md / CLAUDE.md.
    RULES=$(mktemp -t lsw-claude-rules)
    if [[ -f "$HOME/.claude/local-model-rules.md" ]]; then cat "$HOME/.claude/local-model-rules.md" > "$RULES"
    elif [[ -f "$APP_RES/local-model-rules.md" ]]; then cat "$APP_RES/local-model-rules.md" > "$RULES"; fi
    if (( ! OPEN )); then
      if [[ -f "$APP_RES/local-guard-rules.md" ]]; then { print; cat "$APP_RES/local-guard-rules.md"; } >> "$RULES"
      else echo "⚠️  guard-rail rules not found in $APP_RES" >&2; fi
    fi
    for f in AGENTS.md CLAUDE.md; do
      [[ -f "$f" ]] && { print "\n# Project instructions ($f)\n"; cat "$f"; } >> "$RULES"
    done
    # Sandbox: writes stay in this folder plus the build tools' own temp and cache folders (without
    # those, every Xcode and SwiftPM build fails). Unless --open: commands that reach outside the
    # sandbox (other apps, launchd, other machines) are denied and nothing may run unsandboxed.
    SETTINGS=$(mktemp -t lsw-claude-settings)
    /usr/bin/python3 - "$SETTINGS" "$OPEN" "$(getconf DARWIN_USER_TEMP_DIR)" "$(getconf DARWIN_USER_CACHE_DIR)" <<'PY'
import json, os, sys
path, open_mode, tmp, cache = sys.argv[1], sys.argv[2] == "1", sys.argv[3], sys.argv[4]
writable = []
for p in (tmp, cache):
    if p:
        writable += [p.rstrip("/"), os.path.realpath(p).rstrip("/")]
writable += ["~/Library/Developer/Xcode", "~/Library/Developer/CoreSimulator/Caches",
             "~/Library/Caches/com.apple.dt.xcodebuild", "~/Library/Caches/org.swift.swiftpm", "~/.swiftpm"]
# Rules match the command text, so the full-path forms are listed too. They're a second layer:
# the sandbox itself is what stops a wrapped call (bash -c '...').
cmds = ("osascript", "launchctl", "ssh", "scp", "sftp", "crontab", "at", "open", "curl", "wget", "nc",
        "sudo", "security", "defaults write", "sandbox-exec", "codesign")
deny = [] if open_mode else ["Bash(%s%s:*)" % (d, c) for c in cmds for d in ("", "/usr/bin/", "/bin/", "/usr/sbin/", "/opt/homebrew/bin/")]
settings = {
    "disableAllHooks": True,
    "sandbox": {"enabled": True, "allowUnsandboxedCommands": open_mode,
                "filesystem": {"allowWrite": sorted(set(writable))}},
    "permissions": {"allow": ["Bash(xcodebuild:*)", "Bash(xcodegen:*)"], "deny": deny},
}
json.dump(settings, open(path, "w"), indent=1)
PY
    # A parent Claude session's variables would otherwise win over ours.
    for v in ${(k)parameters[(I)(ANTHROPIC_*|CLAUDE_*|CLAUDECODE)]}; do unset $v; done
    export ANTHROPIC_BASE_URL="$GATEWAY"
    export ANTHROPIC_API_KEY="llm-switcher"
    export ANTHROPIC_MODEL="$SLOT"
    export ANTHROPIC_DEFAULT_OPUS_MODEL="$SLOT"
    export ANTHROPIC_DEFAULT_SONNET_MODEL="$SLOT"
    export ANTHROPIC_DEFAULT_HAIKU_MODEL="$SLOT"
    export CLAUDE_CODE_AUTO_COMPACT_WINDOW=128000
    export API_TIMEOUT_MS=1800000
    export CLAUDE_STREAM_IDLE_TIMEOUT_MS=900000
    export API_FORCE_IDLE_TIMEOUT=0
    export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
    # Lean, like --bare used to be (which also cut the tools to Bash, Read and Edit): no CLAUDE.md
    # or auto-memory loading (the project files are in the rules above), no user or project
    # settings, hooks, plugins or slash commands; MCP servers only from local-mcp.json.
    export CLAUDE_CODE_DISABLE_CLAUDE_MDS=1
    export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
    MCP=(--strict-mcp-config --mcp-config '{"mcpServers":{}}')
    [[ -f "$HOME/.claude/local-mcp.json" ]] && MCP=(--strict-mcp-config --mcp-config "$HOME/.claude/local-mcp.json")
    exec claude \
      --setting-sources local \
      --model "$SLOT" \
      --settings "$SETTINGS" \
      "${MCP[@]}" \
      --disable-slash-commands \
      --exclude-dynamic-system-prompt-sections \
      --tools "Bash,Read,Edit,Write,Glob,Grep,TodoWrite" \
      --append-system-prompt-file "$RULES" \
      "$@"
    ;;
  codex)
    need_gateway
    if [[ -n $1 && $1 != -* ]]; then MODEL=$1; shift
    else MODEL=$(curl -s -m 30 "$GATEWAY/local/status" | jget 'slots.claude-sonnet-5'); fi
    [[ -n $MODEL ]] || { echo "❌ No model given and nothing on the Sonnet 5 slot. Try: lsw codex <model> (see lsw models)" >&2; exit 1; }
    ensure "$MODEL"
    export LSW_KEY="llm-switcher"
    exec codex \
      -c "model_providers.lsw={name=\"LLM Switcher\",base_url=\"$GATEWAY/v1\",wire_api=\"responses\",env_key=\"LSW_KEY\"}" \
      -c model_provider=lsw -m "$MODEL" "$@"
    ;;
  tune)
    [[ -n $1 ]] || { echo "usage: lsw tune <model or slot>" >&2; exit 2; }
    need_gateway
    target=$1; s=$(slot_id "$1" 2>/dev/null) && [[ $1 == (sonnet|opus|fable|haiku|sonnet46) ]] && target=$s
    ctl recommend "$(jarg model "$target")" 60 | /usr/bin/python3 -c 'import sys,json
r=json.load(sys.stdin)
if "error" in r: sys.exit("❌ "+r["error"])
print(r["model"]); b=r.get("base_model"); b and print("  base model: "+b)
for x in r.get("recommendations", []): print("  {settings}\n    from {source}".format(**x))
if "note" in r: print("  " + r["note"])
if "thinking_switch" in r:
    lv = ", ".join(r.get("thinking_levels") or []) or "none listed"
    sw = "yes" if r["thinking_switch"] else "no"
    d = " (default {})".format(r["thinking_default"]) if r.get("thinking_default") else ""
    print("  thinking switch: {} · levels: {}{}".format(sw, lv, d))
print("Apply in LLM Switcher: Settings > Models > the model > Recommended settings.")'
    ;;
  bench)
    [[ -n $1 ]] || { echo "usage: lsw bench <model or slot> [hard|all|none] [default|off|low|medium|high]" >&2; exit 2; }
    need_gateway
    target=$1; s=$(slot_id "$1" 2>/dev/null) && [[ $1 == (sonnet|opus|fable|haiku|sonnet46) ]] && target=$s
    args=$(/usr/bin/python3 -c 'import json,sys; print(json.dumps({"model": sys.argv[1], "coding": sys.argv[2], "thinking": sys.argv[3]}))' "$target" "${2:-hard}" "${3:-default}")
    echo "… benchmarking $target (coding: ${2:-hard}, thinking: ${3:-default}); this can take a while"
    out=$(curl -s -m 14400 -X POST "$GATEWAY/local/bench" -H 'content-type: application/json' -d "$args")
    print -r -- "$out" | /usr/bin/python3 -c 'import sys,json
d=json.load(sys.stdin)
for line in d.get("log", []): print(line)
if "error" in d: sys.exit("❌ " + d["error"])
r=d["result"]
def f(v, n=1): return "–" if v is None else ("{:.%df}" % n).format(v)
print("\nScorecard: {}".format(r["model"]))
print("  first word {}s · write {} t/s · read {} t/s{} · 4 at once {} t/s".format(f(r.get("firstWord")), f(r.get("writeSpeed"),0), f(r.get("readSpeed"),0), "" if r.get("readRecall") in (None, True) else " (missed recall)", f(r.get("parallelSpeed"),0)))
t = r.get("toolCall"); print("  tool call: {}".format("–" if t is None else ("ok" if t else "failed")))
if r.get("codingTotal"): print("  coding: {}/{}".format(r["codingPassed"], r["codingTotal"]))
print("  {:.1f} min".format(r["minutes"]))'
    ;;
  buildbench)
    [[ -n $1 ]] || { echo "usage: lsw buildbench <model or slot> [minutes]" >&2; exit 2; }
    need_gateway
    target=$1
    if s=$(slot_id "$1" 2>/dev/null) && [[ $1 == (sonnet|opus|fable|haiku|sonnet46) ]]; then
      target=$(curl -s -m 30 "$GATEWAY/local/status" | jget "slots.$s")
      [[ -n $target ]] || { echo "❌ Nothing is on the $1 slot." >&2; exit 1; }
    fi
    ensure "$target"
    [[ -f "$APP_RES/buildbench/driver.py" ]] || { echo "❌ Build Bench files not found in $APP_RES" >&2; exit 1; }
    exec /usr/bin/python3 "$APP_RES/buildbench/driver.py" --model "$target" --minutes "${2:-45}"
    ;;
  stats)
    model=""; since=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --since) since=$2; shift 2 ;;
        *) model=$1; shift ;;
      esac
    done
    if [[ -n $model ]] && s=$(slot_id "$model" 2>/dev/null) && [[ $model == (sonnet|opus|fable|haiku|sonnet46) ]]; then
      need_gateway
      slot=$model
      model=$(curl -s -m 30 "$GATEWAY/local/status" | jget "slots.$s")
      [[ -n $model ]] || { echo "❌ Nothing is on the $slot slot." >&2; exit 1; }
    fi
    /usr/bin/python3 - "$HOME/Library/Logs/ClaudeLocal/requests.jsonl" "$model" "$since" <<'PY'
import json, sys, re, statistics as st
from datetime import datetime, timezone, timedelta
path, want, since = sys.argv[1], sys.argv[2], sys.argv[3]
cut = None
if since:
    m = re.fullmatch(r"(\d+)([mhd])", since)
    if not m: sys.exit("--since takes e.g. 30m, 2h or 1d")
    unit = {"m": "minutes", "h": "hours", "d": "days"}[m.group(2)]
    cut = datetime.now(timezone.utc) - timedelta(**{unit: int(m.group(1))})
rows = []
try:
    for line in open(path):
        try: r = json.loads(line)
        except ValueError: continue
        if want and r.get("model") != want: continue
        if cut:
            try:
                if datetime.fromisoformat(r["date"].replace("Z", "+00:00")) < cut: continue
            except (KeyError, ValueError): continue
        rows.append(r)
except FileNotFoundError:
    sys.exit("No request log yet (" + path + ")")
if not rows: sys.exit("No requests" + (" for " + want if want else "") + (" in the last " + since if since else "") + ".")
by = {}
for r in rows: by.setdefault(r.get("model", "?"), []).append(r)
def num(v, n=0): return "-" if v is None else ("{:,.%df}" % n).format(v)
for model, rs in sorted(by.items(), key=lambda kv: -len(kv[1])):
    ok = [r for r in rs if 200 <= r.get("status", 0) < 300]
    out = sum(r.get("outputTokens", 0) for r in ok); secs = sum(r.get("seconds", 0) for r in ok)
    prompt = sum(r.get("inputTokens", 0) for r in ok)
    # Lines from before 1.5.5 counted cached tokens outside the prompt total: cap at the prompt.
    cached = sum(min(r.get("cachedTokens") or 0, r.get("inputTokens", 0)) for r in ok)
    long = [r["outputTokens"] / r["seconds"] for r in ok if r.get("outputTokens", 0) >= 500 and r.get("seconds")]
    fw = [r["firstWord"] for r in ok if r.get("firstWord") is not None]
    first, last = rs[0].get("date", "")[:16].replace("T", " "), rs[-1].get("date", "")[:16].replace("T", " ")
    print(model)
    print("  {} requests ({} failed), {} to {} UTC".format(len(rs), len(rs) - len(ok), first, last))
    print("  output {} tokens in {:.1f} min of model time: {} tok/s overall".format(num(out), secs / 60, num(out / secs if secs else None, 1)))
    if long:
        print("  replies of 500+ tokens: {}, typical {} tok/s (range {}-{})".format(len(long), num(st.median(long), 1), num(min(long), 1), num(max(long), 1)))
    if fw: print("  first word: median {}s".format(num(st.median(fw), 1)))
    if prompt: print("  prompt {} tokens, {}% read from cache".format(num(prompt), num(100.0 * cached / prompt)))
PY
    ;;
  -h|--help|help)
    sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "lsw: unknown command '$cmd' (lsw help)" >&2; exit 2 ;;
esac
